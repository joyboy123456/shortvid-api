[Unit]
Description=Short-video (Douyin / Kuaishou) Extraction API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/douyin-api
ExecStart=/usr/bin/python3 /root/douyin-api/server.py --port 8765
Restart=always
RestartSec=3
User=root
StandardOutput=append:/root/douyin-api/server.log
StandardError=append:/root/douyin-api/server.log

[Install]
WantedBy=multi-user.target
